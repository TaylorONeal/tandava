# =============================================================================
# Tandava Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# See docs/developer/setup.md for detailed setup instructions.
# =============================================================================

# -----------------------------------------------------------------------------
# Demo Mode (Optional — runs without any backend)
# -----------------------------------------------------------------------------
# Set to "true" to use mock data without Supabase. Useful for UI development.
VITE_DEMO_MODE=false

# -----------------------------------------------------------------------------
# Supabase (Required for production)
# -----------------------------------------------------------------------------
# Get these from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# Stripe (Required for payments)
# -----------------------------------------------------------------------------
# Get these from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here
# Server-side only (set as Supabase secrets, NOT in frontend):
#   supabase secrets set STRIPE_SECRET_KEY=sk_test_...
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...   (from the webhook endpoint)
#   supabase secrets set APP_URL=https://your-studio.com   (checkout success/cancel + portal return)
#   supabase secrets set PLATFORM_FEE_BPS=0                (platform/multi-studio mode only)
# STRIPE_SECRET_KEY=sk_test_your-key-here
# STRIPE_WEBHOOK_SECRET=whsec_your-secret-here

# -----------------------------------------------------------------------------
# Sentry (Optional — error monitoring)
# -----------------------------------------------------------------------------
# Get these from: https://sentry.io → Project Settings → Client Keys (DSN)
VITE_SENTRY_DSN=
# Used only at build time for source map upload
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# Email Provider (Configured in Supabase Edge Functions)
# -----------------------------------------------------------------------------
# Provider: "resend" | "sendgrid" | "smtp" | "console"
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your-key-here
# SENDGRID_API_KEY=SG.your-key-here
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@your-studio.com
# EMAIL_FROM_NAME=Your Studio Name

# -----------------------------------------------------------------------------
# SMS (Configured in the `sms` Edge Function — set as Supabase secrets)
# -----------------------------------------------------------------------------
# SMS_PROVIDER: "twilio" | "console"
# supabase secrets set SMS_PROVIDER=twilio
# supabase secrets set TWILIO_ACCOUNT_SID=AC... TWILIO_AUTH_TOKEN=... TWILIO_FROM=+1...

# -----------------------------------------------------------------------------
# Web Push (Configured in the `push` Edge Function — set as Supabase secrets)
# -----------------------------------------------------------------------------
# Generate keys once: npx web-push generate-vapid-keys
# supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:you@studio.com
# Expose the public key to the frontend for subscription:
# VITE_VAPID_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
VITE_APP_URL=http://localhost:8080
VITE_APP_NAME=Tandava

# -----------------------------------------------------------------------------
# Per-studio subdomains (Optional — hosted platform only)
# -----------------------------------------------------------------------------
# Set to your platform root domain to enable studio subdomains, e.g.
# oxatl.tandavastudio.com → that studio's public storefront. Requires a
# wildcard domain (*.<root>) pointed at this app. Leave blank to disable
# (apex-only / self-hosted single-studio). See docs/OPERATOR_SETUP.md.
# VITE_ROOT_DOMAIN=tandavastudio.com
